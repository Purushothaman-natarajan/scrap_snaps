# === Required: Azure OpenAI (Corporate Gateway) ===
# Corporate Azure gateway uses custom auth headers, not a standard API key.
# "nokey" is used as placeholder — the gateway authenticates via consumer header.
AZURE_ENDPOINT=https://your-corporate-gateway.example.com/
AZURE_DEPLOYMENT=your-deployment-name
AZURE_CONSUMER_ID=your-consumer-id

# === Required: SerpAPI ===
# SerpAPI key for Google Search (https://serpapi.com/)
SERPAPI_KEY=your_serpapi_key_here

# === Database ===
# SQLAlchemy connection string (sqlite, postgresql, mysql)
DATABASE_URL=sqlite:///research.db

# === Execution ===
# Max planner iterations before forced stop (prevents infinite loops)
MAX_ITERATIONS=30
# LangGraph recursion limit (auto-scaled to max(MAX_ITERATIONS*8, this value))
RECURSION_LIMIT=200
# Comma-separated image views to collect per product
REQUIRED_VIEWS=front,back,side,top
# Comma-separated focus areas (product_pages, seller_images, youtube, price_comparison, specs)
FOCUS_AREAS=product_pages,seller_images,youtube,specs
# Collect specifications from web pages (true/false)
COLLECT_SPECS=true
# What media to collect: images, videos, or both
COLLECT_MEDIA=both

# === Networking ===
# Minimum seconds between HTTP requests (rate limiting)
RATE_LIMIT_INTERVAL=1.0
# HTTP request timeout in seconds
REQUEST_TIMEOUT=10.0
# User-Agent header for all HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# === Playwright (JS rendering) ===
# Page navigation timeout in milliseconds
PLAYWRIGHT_NAV_TIMEOUT=30000
# Element wait timeout in milliseconds
PLAYWRIGHT_SELECTOR_TIMEOUT=10000

# === Scraping ===
# Directory for downloaded images
DOWNLOAD_DIR=downloads
# Max images to fetch per search query
MAX_IMAGE_RESULTS=5
# Max characters to extract from web pages
PAGE_TEXT_LIMIT=5000
# Max image file size in bytes (default 10MB)
MAX_DOWNLOAD_SIZE=10485760

# === Video Extraction ===
# Directory for downloaded videos (deleted after frame extraction)
VIDEO_DOWNLOAD_DIR=downloads/videos
# Number of YouTube videos to process per query (1-5)
MAX_VIDEO_RESULTS=2
# Minimum video duration in seconds (skip shorts)
VIDEO_MIN_DURATION=180
# Maximum video duration in seconds (skip long compilations)
VIDEO_MAX_DURATION=900
# Supplemental frame sampling interval in seconds (within detected scenes)
VIDEO_FRAME_INTERVAL=2.0
# Max video resolution to download (480, 720, 1080)
VIDEO_MAX_RESOLUTION=720
# Crop video frames to center region (focus on product, remove borders)
CROP_VIDEO_FRAMES=false
# Use LLM Vision to select the best frames per angle (true/false)
AI_FRAME_SELECTION=true

# === Verification Scoring ===
# Weight for product identity confidence (0.0 - 1.0)
VERIFY_WEIGHT_IDENTITY=0.30
# Weight for evidence/extraction confidence (0.0 - 1.0)
VERIFY_WEIGHT_EVIDENCE=0.25
# Weight for image analysis confidence (0.0 - 1.0)
VERIFY_WEIGHT_IMAGE=0.30
# Base score added to all verification results (0.0 - 1.0)
VERIFY_WEIGHT_BASE=0.15

# === Search Cache ===
# Max cached search results per run (prevents redundant SerpAPI calls)
SEARCH_CACHE_SIZE=500
# Max SerpAPI calls allowed per row/query (prevents quota burn)
SERPAPI_MAX_HITS_PER_ROW=20

# === Failed URL Tracking ===
# Seconds before a failed URL is eligible for retry (default: 300 = 5 min)
FAILED_URL_TTL=300

# === Logging ===
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Output logs as JSON (for production/log aggregation)
LOG_JSON=false
# Include timestamps in logs
LOG_TIMESTAMP=true
# Log all tool/node/agent I/O to file for debugging
LOG_CAPTURE=true
# Path to log file (created automatically)
LOG_FILE=logs/scrap_snaps.log
