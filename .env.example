# scrap_snaps — Credentials
#
# All non-credential settings live in config.yaml.
# This file is ONLY for secrets that should not be committed to git.
#
# Copy to .env and fill in your values:
#   cp .env.example .env

# === Required: Azure OpenAI (Corporate Gateway) ===
# Corporate Azure gateway uses custom auth headers, not a standard API key.
# "nokey" is used as placeholder — the gateway authenticates via consumer header.
AZURE_ENDPOINT=https://your-corporate-gateway.example.com/
AZURE_DEPLOYMENT=your-deployment-name
AZURE_CONSUMER_ID=your-consumer-id

# === Required: SerpAPI ===
# SerpAPI key for Google Search (https://serpapi.com/)
SERPAPI_KEY=your_serpapi_key_here

# === Database ===
# SQLAlchemy connection string (sqlite, postgresql, mysql)
DATABASE_URL=sqlite:///research.db
